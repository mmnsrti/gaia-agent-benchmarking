    "name": "followup_eligible_shared_plan_paired_retrieval_ablation",
    "metric": "Delta_followup",
    "decision_criterion": "Delta_followup > 0",
    "description": "Follow-up-eligible shared-plan paired retrieval ablation where both Branch A (without follow-up search) and Branch B (with follow-up search) receive identical question, Search 1 evidence, file context, planner output, and plan.",
    "interpretation": "isolates_marginal_effect_of_search_2_evidence_residual_generation_stochasticity_remains",
    "boundary": "pre_recovery_upstream_candidate",
