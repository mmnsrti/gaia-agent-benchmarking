{
  "project_version": "v2",
  "description": "Single-shot Tavily web retrieval baseline extended with local file/attachment handling for Gemini",
  "model": "gemini-3.5-flash-lite",
  "prompt_version": "file-search-v1",
  "primary_prompt_version": "file-search-v1",
  "fallback_prompt_version": "web-search-v1",
  "temperature": null,
  "thinking_level": "medium",
  "max_output_tokens": 2048,
  "search_provider": "tavily",
  "search_depth": "basic",
  "max_results": 5,
  "include_answer": false,
  "include_raw_content": false,
  "include_images": false,
  "auto_parameters": false,
  "max_query_length": 1500,
  "search_calls_per_task": 1,
  "query_rewriting": false,
  "iterative_search": false,
  "file_handling_enabled": true,
  "max_text_chars": 50000,
  "python_execution": false,
  "ocr_enabled": false,
  "multimodal_dispatch": true,
  "supported_file_types": [
    ".txt",
    ".md",
    ".csv",
    ".json",
    ".py",
    ".docx",
    ".xlsx",
    ".pptx",
    ".png",
    ".jpg",
    ".jpeg",
    ".mp3",
    ".pdf"
  ],
  "dataset": "GAIA 2023 Validation",
  "scorer": "official-gaia-leaderboard"
}

