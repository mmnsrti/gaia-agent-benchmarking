  "evaluation_schema_version": 5,
  "research_label": "read_only_self_evaluation_failure_detection",
  "parent_version": "v5",
  "parent_baseline": "frozen V5 (one-shot post-answer verification)",
  "capability_added": "one_bounded_read_only_self_evaluation_generation",
  "research_question": "Can a bounded self-evaluator reliably detect when the agent's non-empty final answer is likely incorrect, without modifying the answer or using additional tools?",
  "frozen_upstream_configuration_source": "experiments/v5/config.json",
  "model_configuration": {
    "model": "gemini-3.5-flash-lite",
    "thinking_level": "medium",
    "max_output_tokens": 2048,
