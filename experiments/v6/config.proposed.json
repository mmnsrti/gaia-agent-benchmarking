  "file_configuration": {
    "status": "inherited_from_frozen_v5",
    "supported_extensions": [".txt", ".md", ".csv", ".json", ".py", ".docx", ".xlsx", ".pptx", ".png", ".jpg", ".jpeg", ".pdf", ".mp3"],
