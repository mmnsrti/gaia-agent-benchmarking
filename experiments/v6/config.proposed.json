    "mutates_answer": false,
    "tools": "none",
    "search": false,
    "python": false,
    "function_calling": "NONE",
    "input_policy": "question_existing_evidence_existing_file_context_final_answer_compact_execution_summary",
    "forbidden_inputs": ["ground_truth", "expected_answer", "scorer_result", "scorer_internals", "v5_verifier_verdict", "v5_verifier_raw_response", "hidden_reasoning"],
    "assessment_values": ["PASS", "SUSPECT"],
    "risk_types": ["NONE", "EVIDENCE", "REASONING", "CALCULATION", "FORMAT", "EXECUTION", "UNKNOWN"],
    "confidence_range": [0.0, 1.0],
