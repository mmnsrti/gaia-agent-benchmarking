    "fallback_on_failure": true,
    "retries_permitted": 0,
    "isolation_type": "best_effort_research_execution_isolation",
    "extraction_contract": "FINAL_ANSWER: <answer>",
    "known_marker_failure_preserved": true
  },
  "router_configuration": {
    "status": "frozen_v5_semantics_strictly_preserved",
    "generation_attempts": 1,
    "output_contract": "ROUTE: DIRECT or ROUTE: PYTHON",
    "allowed_routes": ["DIRECT", "PYTHON"],
    "fallback_policy": "pre_registered_conservative_deterministic_fallback_to_direct_without_python"
  },
  "worker_configuration": {
    "status": "frozen_v5_semantics_strictly_preserved",
    "generation_attempts": 1,
    "direct_output_contract": "FINAL: <answer>",
    "python_output_contract": "```python ... ``` printing FINAL_ANSWER: <answer>"
  },
  "verifier_configuration": {
    "status": "frozen_v5_semantics_strictly_preserved",
    "generation_attempts_max": 1,
    "prompt_version": "answer-verifier-v1",
    "allowed_verdicts": ["KEEP", "REVISE"],
    "output_contract": "VERDICT: KEEP or VERDICT: REVISE with FINAL: <corrected answer>",
    "eligibility_policy": "candidate_answer and candidate_answer.strip()",
    "information_firewall": true,
    "multimodal_bytes_reuse": true,
    "non_destructive_fallback": true,
    "allowed_error_types": [
      "provider_timeout",
      "provider_api_error",
      "malformed_function_call_finish_reason",
      "empty_verifier_response",
      "missing_verdict",
      "ambiguous_verdict",
      "malformed_verifier_text",
      "revise_missing_final",
      "revise_empty_final"
